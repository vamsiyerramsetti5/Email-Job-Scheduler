generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  googleId        String?
  avatar          String?
  slackToken      String?
  slackWebhookUrl String?
  slackChannel    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  jobs            ScheduledJob[]
  emails          EmailLog[]
}

model ScheduledJob {
  id            String     @id @default(uuid())
  userId        String
  senderEmail   String
  subject       String
  body          String
  status        String     @default("SCHEDULED") // SCHEDULED, PROCESSING, COMPLETED, FAILED
  scheduledTime DateTime
  delaySeconds  Int        @default(2)
  hourlyLimit   Int        @default(50)
  totalLeads    Int        @default(0)
  sentCount     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails        EmailLog[]
}

model EmailLog {
  id                 String        @id @default(uuid())
  jobId              String
  userId             String
  recipient          String
  sender             String
  subject            String
  body               String
  status             String        @default("SCHEDULED") // SCHEDULED, SENT, FAILED, DELAYED_RATE_LIMIT
  scheduledFor       DateTime
  sentAt             DateTime?
  etherealPreviewUrl String?
  messageId          String?
  error              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  job                ScheduledJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}
